# Optional. The zero-key optimizer, dashboard and MCP tools do NOT need this.
# Only /v1/chat/completions proxy mode uses an upstream provider API key.
OPENAI_API_KEY=
UPSTREAM_BASE_URL=https://api.openai.com
DEFAULT_MODEL=gpt-4.1-mini
FALLBACK_MODEL=gpt-4.1
CHEAP_MODEL=gpt-4.1-nano
MAX_RECENT_MESSAGES=8
MAX_OUTPUT_TOKENS=1200
CACHE_TTL_SECONDS=86400
DATABASE_PATH=./data/token_shield.db
MCP_HOST=127.0.0.1
MCP_PORT=8001
# For public HTTPS deployment, set exact host/origin allowlists, comma-separated.
# Example: token-shield.example.com,token-shield.example.com:*
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
